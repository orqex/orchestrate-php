{
    "name": "orqex/orchestrate-php",
    "description": "Official PHP SDK for the Orqex payment orchestration API.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://orqex.com",
    "keywords": [
        "orqex",
        "orchestrate",
        "payment",
        "payments",
        "orchestration",
        "mobile-money",
        "sdk",
        "api"
    ],
    "authors": [
        {
            "name": "Orqex",
            "homepage": "https://orqex.com"
        }
    ],
    "support": {
        "issues": "https://github.com/orqex/orchestrate-php/issues",
        "source": "https://github.com/orqex/orchestrate-php",
        "docs": "https://docs.orqex.com"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "axazara/php-cs": "^0.4",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "phpstan/phpstan": "^2.0",
        "orchestra/testbench": "^10.0"
    },
    "suggest": {
        "illuminate/support": "Enables the Laravel service provider and the Orchestrate facade (auto-discovered inside Laravel applications)."
    },
    "autoload": {
        "psr-4": {
            "Orqex\\Orchestrate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orqex\\Orchestrate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Orqex\\Orchestrate\\Laravel\\OrchestrateServiceProvider"
            ],
            "aliases": {
                "Orchestrate": "Orqex\\Orchestrate\\Laravel\\Facades\\Orchestrate"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "format": "php-cs-fixer fix",
        "sniff": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
